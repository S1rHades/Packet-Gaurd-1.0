<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base theme for system surfaces (the window before Compose draws, the toggle shortcut). The UI itself is Compose. -->
    <style name="Theme.PacketGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#1E40AF</item>
        <item name="android:colorPrimaryDark">#1E3A8A</item>
        <item name="android:colorAccent">#3B82F6</item>
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
    </style>

    <style name="Theme.PacketGuard.Main">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
